<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="bookusers.FormListado">
  <grid id="a2000" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="28">
    <margin top="36" left="40" bottom="36" right="40"/>
    <constraints>
      <xy x="20" y="20" width="714" height="528"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a2001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="44" style="1"/>
          <text value="Usuarios registrados"/>
        </properties>
      </component>
      <scrollpane id="a2002">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a2003" class="javax.swing.JList" binding="lstUsuarios">
            <constraints/>
            <properties>
              <fixedCellHeight value="54"/>
              <font size="26" style="0"/>
              <selectionMode value="0"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="a2005" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="20" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a2004" class="javax.swing.JButton" binding="btnVerDetalle">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="280" height="64"/>
              </grid>
            </constraints>
            <properties>
              <font size="28" style="1"/>
              <text value="Ver detalle"/>
            </properties>
          </component>
          <component id="a2006" class="javax.swing.JButton" binding="btnEliminar">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="320" height="64"/>
              </grid>
            </constraints>
            <properties>
              <font size="28" style="1"/>
              <text value="Eliminar usuario"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
